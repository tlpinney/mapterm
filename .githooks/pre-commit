#!/bin/sh
# Format and lint before each commit, as CI does. Enable once per clone:
#   git config core.hooksPath .githooks
# Skip in a pinch with `git commit --no-verify` (CI still checks).
set -e
cargo fmt --check || { echo "pre-commit: run 'cargo fmt' first" >&2; exit 1; }
cargo clippy --all-targets --locked -q -- -D warnings
